[
  {
    "label": "opencode",
    "command": "opencode --auto",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "on_success",
  },
  {
    "label": "hunk diff",
    "command": "EDITOR=zed hunk diff",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
  },
  {
    "label": "lazygit",
    "command": "EDITOR=zed lazygit",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "on_success",
  },
  {
    "label": "terminal",
    "command": "setsid --fork xdg-terminal-exec </dev/null >/dev/null 2>&1",
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "hide": "always",
    "reveal": "never",
  },
]
