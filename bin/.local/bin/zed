#!/usr/bin/env sh
# One `zed` name everywhere: prefer `zeditor`, else a real `zed` on PATH.
if command -v zeditor >/dev/null 2>&1; then
    exec zeditor "$@"
fi

# Guard: symlinked PATH dirs can expose this wrapper twice, which would
# otherwise delegate to itself forever.
if [ -n "${_ZED_WRAPPER_SEEN:-}" ]; then
    echo "zed: no zed or zeditor binary found on PATH" >&2
    exit 127
fi

# Remove our own directory from PATH, then resolve `zed` once more.
me=$(command -v zed)
me_dir=${me%/*}
restored_ifs=$IFS
IFS=:
rest=
for dir in $PATH; do
    [ "${dir:-.}" = "$me_dir" ] || rest="${rest:+$rest:}${dir:-.}"
done
IFS=$restored_ifs

next=$(PATH=$rest command -v zed) || {
    echo "zed: no zed or zeditor binary found on PATH" >&2
    exit 127
}
export _ZED_WRAPPER_SEEN=1
exec "$next" "$@"
