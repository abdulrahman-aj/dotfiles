#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  worktree <command> [<args>]

Commands:
  create <task-slug>...  Create or print managed worktree paths (fail-fast).
  list [--porcelain]  List all worktrees for the current repository.
  path <task-slug>...    Print the managed paths for tasks (all-or-nothing).
  remove [--force] <task-slug>...
                        Remove task worktrees; retain branches (--force discards changes).
  repair [path...]    Repair Git worktree metadata after a move.
  help                Show this help.

Task slugs use lowercase letters, digits, and hyphens. Managed worktrees live
at ${WORKTREES_DIR:-$HOME/Worktrees}/<repository>/<task-slug> on branches named
work/<task-slug>. New branches always start from the repository's local main.
Repository directory names must be unique under the worktree directory. Set
WORKTREES_DIR to isolate repositories with the same name.
EOF
}

die() {
  printf 'worktree: %s\n' "$*" >&2
  exit 1
}

err() {
  printf 'worktree: %s\n' "$*" >&2
}

valid_slug() {
  [[ ${1:-} =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

task_slug() {
  valid_slug "${1:-}" ||
    die "task slug must use lowercase letters, digits, and hyphens"
}

primary_worktree() {
  local worktrees

  worktrees=$(git worktree list --porcelain 2>/dev/null) || die "not inside a Git worktree"
  printf '%s\n' "$worktrees" | awk '/^worktree / { print substr($0, 10); exit }'
}

repository_root() {
  local primary root
  primary=$(primary_worktree)
  [[ -n $primary ]] || return 1
  root=$(git -C "$primary" rev-parse --show-toplevel 2>/dev/null) ||
    die "bare repositories have no primary worktree"
  printf '%s\n' "$root"
}

same_directory() {
  local first second
  first=$(cd "$1" 2>/dev/null && pwd -P)
  second=$(cd "$2" 2>/dev/null && pwd -P)
  [[ $first == "$second" ]]
}

worktree_for_branch() {
  local root=$1
  local branch=$2

  git -C "$root" worktree list --porcelain |
    awk -v branch="branch refs/heads/$branch" '
      /^worktree / { path = substr($0, 10) }
      $0 == branch { print path; exit }
    '
}

managed_path() {
  local root=$1
  local task=$2
  local worktrees_dir=${WORKTREES_DIR:-"$HOME/Worktrees"}

  [[ $worktrees_dir == /* ]] || die "WORKTREES_DIR must be an absolute path"
  printf '%s/%s/%s\n' "$worktrees_dir" "$(basename "$root")" "$task"
}

create_one() {
  local root=$1
  local task=$2
  local branch path existing
  branch="work/$task"
  path=$(managed_path "$root" "$task")
  existing=$(worktree_for_branch "$root" "$branch")

  if [[ -n $existing ]]; then
    [[ -d $existing ]] ||
      die "$task: registered worktree '$existing' is missing; run 'worktree repair <new-path>' if moved or 'git worktree prune' if deleted"
    if same_directory "$existing" "$path"; then
      printf '%s\n' "$path"
      return
    fi
    die "$task: branch '$branch' is already checked out at '$existing'"
  fi

  [[ ! -e $path ]] || die "$task: path already exists but is not registered as '$branch': '$path'"
  mkdir -p "$(dirname "$path")"
  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" worktree add "$path" "$branch" >&2
  else
    git -C "$root" show-ref --verify --quiet refs/heads/main || die "$task: local branch 'main' does not exist"
    git -C "$root" worktree add -b "$branch" "$path" main >&2
  fi
  printf '%s\n' "$path"
}

remove_one() {
  local root=$1
  local current_root=$2
  local task=$3
  local force=$4
  local branch path target_root actual_branch
  valid_slug "$task" || {
    err "$task: task slug must use lowercase letters, digits, and hyphens"
    return 1
  }
  branch="work/$task"
  path=$(managed_path "$root" "$task")
  [[ -d $path ]] || {
    err "$task: no worktree exists at '$path'"
    return 1
  }
  actual_branch=$(git -C "$path" branch --show-current 2>/dev/null) || {
    err "$task: '$path' is not a Git worktree"
    return 1
  }
  [[ $actual_branch == "$branch" ]] || {
    err "$task: '$path' is not checked out on '$branch'"
    return 1
  }
  target_root=$(git -C "$path" rev-parse --show-toplevel)
  [[ $current_root != "$target_root" ]] || {
    err "$task: leave '$path' before removing it"
    return 1
  }

  # Without --force, git refuses dirty worktrees, preserving unfinished changes.
  if [[ $force == 1 ]]; then
    git -C "$root" worktree remove --force "$path" || {
      err "$task: failed to remove '$path'"
      return 1
    }
  else
    git -C "$root" worktree remove "$path" || {
      err "$task: failed to remove '$path'"
      return 1
    }
  fi
}

main() {
  local command=${1:-help}
  local root current_root

  case $command in
    create)
      [[ $# -ge 2 ]] || die "usage: worktree create <task-slug>..."
      for arg in "${@:2}"; do
        [[ $arg != -* ]] || die "usage: worktree create <task-slug>..."
      done
      root=$(repository_root)
      [[ ${WORKTREES_DIR:-"$HOME/Worktrees"} == /* ]] || die "WORKTREES_DIR must be an absolute path"
      for task in "${@:2}"; do
        valid_slug "$task" || die "$task: task slug must use lowercase letters, digits, and hyphens"
        create_one "$root" "$task"
      done
      ;;
    list)
      [[ $# -eq 1 || ($# -eq 2 && $2 == --porcelain) ]] ||
        die "usage: worktree list [--porcelain]"
      root=$(repository_root)
      git -C "$root" worktree list "${@:2}"
      ;;
    path)
      [[ $# -ge 2 ]] || die "usage: worktree path <task-slug>..."
      for arg in "${@:2}"; do
        [[ $arg != -* ]] || die "usage: worktree path <task-slug>..."
      done
      root=$(repository_root)
      [[ ${WORKTREES_DIR:-"$HOME/Worktrees"} == /* ]] || die "WORKTREES_DIR must be an absolute path"
      for task in "${@:2}"; do
        valid_slug "$task" || die "$task: task slug must use lowercase letters, digits, and hyphens"
      done
      for task in "${@:2}"; do
        managed_path "$root" "$task"
      done
      ;;
    remove)
      shift
      local force=0
      local tasks=()
      for arg in "$@"; do
        if [[ $arg == --force ]]; then
          force=1
        elif [[ $arg == -* ]]; then
          die "usage: worktree remove [--force] <task-slug>..."
        else
          tasks+=("$arg")
        fi
      done
      [[ ${#tasks[@]} -ge 1 ]] || die "usage: worktree remove [--force] <task-slug>..."
      root=$(repository_root)
      [[ ${WORKTREES_DIR:-"$HOME/Worktrees"} == /* ]] || die "WORKTREES_DIR must be an absolute path"
      current_root=$(git rev-parse --show-toplevel)
      local succeeded=0 failed=0
      local task
      for task in "${tasks[@]}"; do
        if remove_one "$root" "$current_root" "$task" "$force"; then
          succeeded=$((succeeded + 1))
        else
          failed=$((failed + 1))
        fi
      done
      if [[ $failed -gt 0 ]]; then
        err "removed $succeeded of ${#tasks[@]}"
        exit 1
      fi
      ;;
    repair)
      shift
      root=$(repository_root)
      current_root=$(git rev-parse --show-toplevel)
      [[ $current_root == "$root" ]] || die "run 'worktree repair' from the repository's primary worktree"
      git worktree repair "$@"
      ;;
    help|-h|--help)
      [[ $# -le 1 ]] || die "usage: worktree help"
      usage
      ;;
    *)
      die "unknown command '$command'; run 'worktree help'"
      ;;
  esac
}

main "$@"
