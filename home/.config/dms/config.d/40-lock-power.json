{
  "lockScreenWidgetInstances": [
    {
      "id": "lock_clock",
      "widgetType": "desktopClock",
      "enabled": true,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true,
        "style": "expressive",
        "autoPosition": true
      }
    },
    {
      "id": "lock_date",
      "widgetType": "lockDate",
      "enabled": false,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true,
        "format": "short",
        "colorMode": "default",
        "customColor": "#ffffff"
      }
    },
    {
      "id": "lock_auth",
      "widgetType": "lockAuth",
      "enabled": true,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true
      }
    },
    {
      "id": "lock_notifications",
      "widgetType": "lockNotifications",
      "enabled": false,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true,
        "mode": 2
      }
    },
    {
      "id": "lock_status",
      "widgetType": "lockStatus",
      "enabled": true,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true,
        "showMediaPlayer": false
      }
    },
    {
      "id": "lock_power",
      "widgetType": "lockPower",
      "enabled": false,
      "config": {
        "displayPreferences": [
          "all"
        ],
        "syncPositionAcrossScreens": true,
        "shape": "round"
      }
    }
  ],
  "acMonitorTimeout": 900,
  "batteryMonitorTimeout": 900,
  "acLockTimeout": 900,
  "batteryLockTimeout": 900,
  "batterySuspendTimeout": 1800,
  "lockBeforeSuspend": true
}
