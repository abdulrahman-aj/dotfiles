{
  "keyboardLayouts": "us,ara",
  "keyboardOptions": "grp:alts_toggle",
  "keyboardRepeatDelay": 250,
  "keyboardRepeatRate": 40,
  "keyboardNumlock": true,
  "niriLayoutBorderSize": 1,
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": true,
      "position": 0,
      "showOnLastDisplay": true,
      "leftWidgets": [
        "launcherButton",
        {
          "id": "workspaceSwitcher",
          "showOccupiedWorkspacesOnly": true
        },
        "focusedWindow"
      ],
      "centerWidgets": [
        "music",
        "clock",
        "weather"
      ],
      "rightWidgets": [
        "systemTray",
        "clipboard",
        "cpuUsage",
        "memUsage",
        "notificationButton",
        "battery",
        "controlCenterButton"
      ],
      "island": true
    }
  ],
  "lockScreenWidgetInstances": [
    {
      "id": "lock_clock",
      "widgetType": "desktopClock",
      "enabled": true,
      "config": {
        "syncPositionAcrossScreens": true,
        "style": "expressive"
      }
    },
    {
      "id": "lock_date",
      "widgetType": "lockDate",
      "enabled": false,
      "config": {
        "syncPositionAcrossScreens": true,
        "format": "short"
      }
    },
    {
      "id": "lock_auth",
      "widgetType": "lockAuth",
      "enabled": true,
      "config": {
        "syncPositionAcrossScreens": true
      }
    },
    {
      "id": "lock_status",
      "widgetType": "lockStatus",
      "enabled": true,
      "config": {
        "syncPositionAcrossScreens": true,
        "showMediaPlayer": false
      }
    },
    {
      "id": "lock_power",
      "widgetType": "lockPower",
      "enabled": true,
      "config": {
        "syncPositionAcrossScreens": true
      }
    }
  ],
  "acMonitorTimeout": 900,
  "batteryMonitorTimeout": 900,
  "acLockTimeout": 900,
  "batteryLockTimeout": 900,
  "batterySuspendTimeout": 1800,
  "lockBeforeSuspend": true
}
