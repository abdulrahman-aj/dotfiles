{
  "$schema": "https://opencode.ai/config.json",
  "username": "Abdulrahman",
  "instructions": [
    "~/.ai/memories/personal.md",
    "~/.ai/memories/principles.md",
    "~/.config/opencode/memories/agent-delegation.md",
    "~/.ai/memories/privilege-elevation.md"
  ],
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "linear-source": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": true
    }
  }
}
