// Personal Niri settings. arch-niri-dux 0.3 loads this file last, after its
// defaults and Dux's generated dms/*.kdl, so these settings win.

layout {
    // Full-width tiled columns without imposing a width on floating dialogs.
    default-column-width { proportion 1.0; }
}

// Alt+Tab cycles windows on the current workspace only. Kept outside Dux's
// writer until it preserves MRU bindings on shortcut saves.
recent-windows {
    binds {
        Alt+Tab { next-window scope="workspace"; }
        Alt+Shift+Tab { previous-window scope="workspace"; }
    }
}

// Mod+U opens the Dash on the AI Usage tab (dux-ai-usage plugin). It replaces
// the default focus-workspace-down here, which stays on Mod+J.
binds {
    Mod+U hotkey-overlay-title="AI Usage" { spawn "dms" "ipc" "call" "dash" "toggle" "plugin_duxAiUsage"; }
}
